node_modules/
*.log
dist/

# CI checks the hub repo out here to run its canonical gates (Doctrine 9b);
# ignored so a local clone in the same layout can never be committed.
.hub-gates

# Build output. The source is src/ui/*.ts; public/app.js is generated by
# `npm run build` and is deliberately NOT committed — a generated artifact in
# the tree drifts from its source and starts getting hand-edited.
public/app.js
public/app.js.map

# The gate audit's plant record (tools/gate-audit.mjs). Written before the tree
# is broken on purpose and deleted when it is put back, so a run that dies leaves
# it behind for the next run to replay. Machinery, never a deliverable — and the
# DAMAGE it records shows in `git status` on its own, which is the signal worth
# seeing.
.gate-audit-plant.json
