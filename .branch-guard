# Product work waits on staging for the on-device pass (CLAUDE.md, Doctrine 7).
work=staging
promote=main
escape=QUIETKEEP_PROMOTE
# `tour-fresh` WAS HERE AND IS NOT ANY MORE (2026-08-27). The walkthrough's ten
# photographs are illustrations, and a stale illustration is not a correctness
# failure of the app — but the check's trigger was far wider than its output. It
# hashes five WHOLE FILES, `public/app.css` and `src/ui/work.ts` among them, for
# ten pictures of six surfaces, so editing a comment in one of them marked all
# ten stale and refused the commit. `npm run tour:check` is a Spine step
# (spine.yml:318) and the Spine runs before a push, so nothing can reach
# production stale that was not already going to.
#
# `a11y-fresh` STAYS MANDATORY. It is the receipt that the accessibility walk
# actually ran against THIS markup, and deferring it ships markup nobody
# measured — the failure this app is a rebuttal to.
also=tools/hooks/a11y-fresh.sh
also=tools/hooks/branch-state.sh

# The named way past, for when the work has to happen in a different order.
# Without one, the way past is `--no-verify`, which switches off the BRANCH rule
# as well. Deferred is not skipped: both checks above are also CI steps.
escape-also=QUIETKEEP_DEFER
